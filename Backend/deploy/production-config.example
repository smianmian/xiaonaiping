XNP_DEPLOYMENT_TARGET=huawei_baota
XNP_HOST=127.0.0.1
XNP_PORT=8787
XNP_DATA_DIR=/srv/xiaonaiping/data
XNP_SECRET_KEY=replace-in-private-deployment
XNP_ADMIN_TOKEN=replace-in-private-deployment
XNP_AUTH_DEBUG_MODE=0

XNP_DATABASE_BACKEND=mysql
XNP_MYSQL_HOST=127.0.0.1
XNP_MYSQL_PORT=3306
XNP_MYSQL_USER=xiaonaiping_app
XNP_MYSQL_PASSWORD=replace-in-private-deployment
XNP_MYSQL_DATABASE=xiaonaiping_prod
XNP_MYSQL_SSL_CA=

XNP_STORAGE_BACKEND=huawei_obs
HUAWEI_OBS_ACCESS_KEY_ID=replace-in-private-deployment
HUAWEI_OBS_SECRET_ACCESS_KEY=replace-in-private-deployment
HUAWEI_OBS_ENDPOINT=replace-with-obs-endpoint
HUAWEI_OBS_BUCKET=xiaonaiping-prod-private
HUAWEI_OBS_PREFIX=xiaonaiping

XNP_SMS_PROVIDER=webhook
XNP_SMS_WEBHOOK_URL=http://127.0.0.1:8791/send
XNP_SMS_SECRET=replace-in-private-deployment
XNP_SMS_TEMPLATE_ID=replace-with-approved-aliyun-template-code

XNP_WECHAT_APP_ID=replace-with-wechat-app-id
XNP_WECHAT_APP_SECRET=replace-in-private-deployment
