  ],
  "refreshSequence": [
    {
      "step": "confirmPrivateProductionEnv",
      "requires": [
        "/srv/xiaonaiping/private/xiaonaiping-api.env exists on the server",
        "XNP_SECRET_KEY is set",
        "XNP_DATA_DIR is set",
        "MySQL database xiaonaiping_prod is selected",
        "Huawei OBS provider and private bucket or prefix are configured",
        "XiaoNaiPing production namespace is isolated from Emotion Isle"
      ],
      "redaction": "Do not print or commit root password, SSH key, XNP_SECRET_KEY, database password, AK/SK, AppSecret, full phone number, verification code, recovery key, or token."
    },
    {
      "step": "refreshDeploymentProof",
      "command": "XNP_DEPLOY_HOST=root@YOUR_SERVER Backend/deploy/deploy-huawei-baota.sh",
      "output": "Backend/proof/huawei-baota-deploy-20260628T-current.json",
      "mustProve": [
        "deploymentProofCurrent",
        "collect_deployment_proof.py",
        "production debug disabled",
        "public /internal routes blocked",
        "xiaonaiping_prod",
        "xiaonaiping_app"
      ]
    },
    {
      "step": "refreshRemoteApiProof",
      "command": "python3 Backend/scripts/verify_remote_api.py --base-url https://api.mewpow.com/xiaonaiping --output Backend/proof/remote-api-20260628T-current.json",
      "output": "Backend/proof/remote-api-20260628T-current.json"
    },
    {
      "step": "refreshStorageProof",
      "command": "python3 Backend/scripts/verify_storage_backend.py --output Backend/proof/storage-backend-20260628T-current.json",
      "output": "Backend/proof/storage-backend-20260628T-current.json",
      "mustProve": [
        "storageBackendProofCurrent",
        "Huawei OBS",
        "private bucket or prefix",
        "photo upload/download/delete",
        "account deletion cleanup"
      ]
    },
    {
      "step": "refreshAuthProviderConfigProof",
      "command": "python3 Backend/scripts/verify_auth_providers.py --live-check --base-url https://api.mewpow.com/xiaonaiping --deployment-proof Backend/proof/huawei-baota-deploy-20260628T-current.json --output Backend/proof/auth-providers-20260628T-current.json --allow-incomplete",
      "output": "Backend/proof/auth-providers-20260628T-current.json",
      "boundary": "This checks provider configuration only; it is not the real SMS live-send proof."
    },
    {
      "step": "refreshSmsLiveSendProof",
      "command": "python3 Backend/scripts/verify_auth_providers.py --live-check --send-test-sms --require-sms-live-send --phone-env XNP_SMS_TEST_PHONE --base-url https://api.mewpow.com/xiaonaiping --deployment-proof Backend/proof/huawei-baota-deploy-20260628T-current.json --output Backend/proof/auth-providers-sms-live-20260628T-current.json --allow-incomplete",
      "output": "Backend/proof/auth-providers-sms-live-20260628T-current.json",
      "boundary": "Do not run with a full phone number in shell history or logs."
    },
    {
      "step": "refreshAppStoreEvidenceProof",
      "command": "python3 Backend/scripts/check_app_store_evidence.py --allow-incomplete --date 2026-06-28 --output Backend/proof/app-store-evidence-20260628T-current.json",
      "output": "Backend/proof/app-store-evidence-20260628T-current.json"
    },
    {
      "step": "refreshProductionReadinessCurrent",
      "command": "python3 Backend/scripts/check_production_readiness.py --deployment-proof Backend/proof/huawei-baota-deploy-20260628T-current.json --storage-proof Backend/proof/storage-backend-20260628T-current.json --auth-providers-proof Backend/proof/auth-providers-sms-live-20260628T-current.json --app-store-evidence Backend/proof/app-store-evidence-20260628T-current.json --require-huawei-obs --require-screenshots --require-app-store-evidence --live-check --output Backend/proof/production-readiness-20260628T-current.json --allow-incomplete",
      "output": "Backend/proof/production-readiness-20260628T-current.json",
      "boundary": "Keep allow-incomplete while collecting evidence; do not claim ready until ready=true."
    },
    {
      "step": "syncStableAliasesAfterGreen",
      "requires": [
        "huawei-baota-deploy-20260628T-current.json is current and passed",
        "remote-api-20260628T-current.json passed",
        "storage-backend-20260628T-current.json passed",
        "auth-providers-sms-live-20260628T-current.json passed",
        "app-store-evidence-20260628T-current.json ready=true",
        "production-readiness-20260628T-current.json ready=true"
      ],
      "commands": [
        "cp Backend/proof/huawei-baota-deploy-20260628T-current.json Backend/proof/huawei-baota-deploy.json",
        "cp Backend/proof/remote-api-20260628T-current.json Backend/proof/remote-api.json",
        "cp Backend/proof/storage-backend-20260628T-current.json Backend/proof/storage-backend.json",
        "cp Backend/proof/auth-providers-sms-live-20260628T-current.json Backend/proof/auth-providers.json",
        "cp Backend/proof/app-store-evidence-20260628T-current.json Backend/proof/app-store-evidence.json",
        "cp Backend/proof/production-readiness-20260628T-current.json Backend/proof/production-readiness.json"
      ],
      "boundary": "Never sync stable aliases from incomplete current proofs."
    },
    {
      "step": "refreshLaunchObjectiveAudit",
      "command": "python3 Backend/scripts/check_launch_objective_audit.py --allow-incomplete --output Backend/proof/launch-objective-audit.json",
      "output": "Backend/proof/launch-objective-audit.json"
    }
  ],
  "stopConditions": [
    {
      "id": "noDeployHost",
      "condition": "XNP_DEPLOY_HOST is missing or points to the wrong server",
      "action": "Stop production refresh and confirm the XiaoNaiPing Huawei Cloud host."
    },
    {
      "id": "missingPrivateEnv",
      "condition": "/srv/xiaonaiping/private/xiaonaiping-api.env is missing or unreadable",
      "action": "Stop production refresh; do not create fake local env files."
    },
    {
      "id": "productionSecretOrDatabaseMissing",
      "condition": "XNP_SECRET_KEY, XNP_DATA_DIR, xiaonaiping_prod, or xiaonaiping_app is missing",
      "action": "Stop and repair server production configuration before rerunning proofs."
    },
    {
      "id": "obsProofMissingOrStale",
      "condition": "Huawei OBS provider, storage-backend-20260628T-current.json, private bucket, or account deletion cleanup proof is missing",
      "action": "Stop and refresh storage proof before syncing stable aliases."
    },
    {
      "id": "smsLiveSendProofMissing",
      "condition": "auth-providers-sms-live-20260628T-current.json is missing or not a real live send",
      "action": "Do not sync auth-providers.json from provider configuration proof alone."
    },
    {
      "id": "wechatProviderMissing",
      "condition": "WeChat provider or real wx AppID/AppSecret is missing",
      "action": "Keep production readiness incomplete until WeChat Open Platform evidence and server env are real."
    },
    {
      "id": "appStoreEvidenceIncomplete",
      "condition": "app-store-evidence-20260628T-current.json is not ready=true",
      "action": "Do not sync app-store-evidence.json and do not claim Submit for Review readiness."
    },
    {
      "id": "ios265EvidenceMissing",
      "condition": "iOS 26.5 TestFlight or signed real-device regression evidence is missing",
      "action": "Do not use iOS 27, simulator, or device availability logs as final evidence."
    },
    {
      "id": "productionReadinessStillRed",
      "condition": "production-readiness-20260628T-current.json is not ready=true",
      "action": "Do not sync production-readiness.json and do not submit."
    }
  ],
  "postRefreshGates": [
    "python3 Backend/scripts/check_provider_evidence_materials.py --output Backend/proof/provider-evidence-materials.json",
    "python3 Backend/scripts/check_app_store_submission_packet.py --output Backend/proof/app-store-submission-packet.json",
    "python3 Backend/scripts/check_launch_blocker_action_packet.py --allow-incomplete --output Backend/proof/launch-blocker-action-packet.json",
    "python3 Backend/scripts/check_production_readiness.py --require-huawei-obs --require-screenshots --require-app-store-evidence --allow-incomplete --output Backend/proof/production-readiness.json",
    "python3 Backend/scripts/check_launch_objective_audit.py --allow-incomplete --output Backend/proof/launch-objective-audit.json"
  ],
  "completionRule": "refresh-plan-not-evidence; not submission permission; this packet only defines the same-day production proof refresh workflow. Production evidence is complete only after real current deployment, remote API, storage, auth provider, App Store evidence, production readiness, and launch objective proofs pass; stable aliases are synced from the same-round current proofs; production-readiness.json ready=true; app-store-evidence.json ready=true; and launch-objective-audit.json ready=true."
