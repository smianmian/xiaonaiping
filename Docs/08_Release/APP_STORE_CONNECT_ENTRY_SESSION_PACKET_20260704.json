      "id": "createOrOpenAppRecord",
      "action": "在正确 Organization 下创建或打开 iOS App 记录。",
      "stopIf": "主体、Bundle ID、SKU 或 Team ID 与源文件不一致"
    },
    {
      "id": "fillAppInformation",
      "action": "填写 App 名称、副标题、分类、版权、隐私政策 URL、技术支持 URL 和用户协议 URL。",
      "evidenceAfter": "AppStoreConnect/ASC-01-app-information.png"
    },
    {
      "id": "fillPricingAvailability",
      "action": "填写免费、Specific Countries or Regions -> China mainland、手动发布和 Phased release off。",
      "evidenceAfter": "AppStoreConnect/ASC-03-pricing-availability-release.png"
    },
    {
      "id": "fillVersionInformation",
      "action": "粘贴描述、关键词、新版本说明，并按最终截图顺序上传。",
      "stopIf": "没有 iOS 26.5 TestFlight 或签名真机包最终截图",
      "evidenceAfter": "AppStoreConnect/ASC-02-version-information.png"
    },
    {
      "id": "fillAppPrivacy",
      "action": "按隐私答案表和隐私标签 JSON 填写 App Privacy。",
      "evidenceAfter": "AppStoreConnect/ASC-04-app-privacy.png"
    },
    {
      "id": "fillAgeRating",
      "action": "按年龄分级答案表填写，不选择 Kids Category，Regulated Medical Device 选择 No。",
      "evidenceAfter": "AppStoreConnect/ASC-05-age-rating.png 和 17-age-rating-result"
    },
    {
      "id": "fillReviewInformation",
      "action": "填写审核备注、联系人和 Sign-In Information 私密字段。",
      "stopIf": "真实恢复密钥、验证码、完整手机号或测试员邮箱会进入仓库材料",
      "evidenceAfter": "AppStoreConnect/ASC-06-review-information.png"
    },
    {
      "id": "attachBuildAndScreenshots",
      "action": "选择 TestFlight 构建并核对截图、版本和 build。",
      "stopIf": "缺少 05-signed-archive.png、06-testflight.png 或 12-real-device-regression.md",
      "evidenceAfter": "AppStoreConnect/ASC-07-build-testflight-link.png"
    },
    {
      "id": "capturePostFillPages",
      "action": "归档 ASC-01 到 ASC-08 页面回填截图或 PDF，并完成脱敏。",
      "evidenceAfter": "Docs/08_Release/AppStoreEvidence/AppStoreConnect/"
    },
    {
      "id": "runPostEntryGates",
      "action": "重跑本包列出的 postEntryGates。",
      "stopIf": "任一 required gate 仍为 false"
    }
